{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@feature/base": ["features/base/src/index.ts"],
      "@feature/base/server": ["features/base/src/server.ts"],
      "@feature/base/*": ["features/base/src/*"],
      "@feature/logging": ["features/logging/src/index.ts"],
      "@feature/logging/server": ["features/logging/src/server.ts"],
      "@feature/logging/config": ["features/logging/src/config.ts"],
      "@feature/logging/*": ["features/logging/src/*"],
      "@onboarding-frontend/auth-0": ["features/auth-0/src/index.ts"],
      "@onboarding-frontend/auth-0/server": ["apps/auth-0/src/server.ts"],
      "@app/web/*": ["apps/web/*"],
      "@feature/auth": ["features/auth/src/index.ts"],
      "@feature/auth/server": ["features/auth/src/server.ts"],
      "@feature/auth/*": ["features/auth/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
